{
  "version": 2,
  "installCommand": "npm install && npm --prefix securestock-ai install",
  "buildCommand": "npm --prefix securestock-ai run build",
  "outputDirectory": "securestock-ai/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
